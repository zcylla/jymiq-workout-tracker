{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always",
      "bracketSpacing": true
    }
  },
  "linter": {
    "enabled": false
  },
  "assist": {
    "enabled": false
  },
  "files": {
    "includes": [
      "**",
      "!android/**",
      "!ios/**",
      "!drizzle/**",
      "!claudedocs/**",
      "!assets/**",
      "!.expo/**",
      "!expo-env.d.ts"
    ]
  },
  "overrides": [
    {
      "includes": ["src/theme/type.ts"],
      "formatter": {
        "lineWidth": 110
      }
    }
  ]
}
