    "lint": "expo lint",
    "prepare": "lefthook install",
    "seed:gen": "node scripts/build-seed.mjs",
    "start": "expo start",
    "test": "node --test --experimental-strip-types src/lib/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "private": true,
  "pnpm": {
    "onlyBuiltDependencies": [
      "@shopify/react-native-skia",
      "esbuild",
      "lefthook",
      "unrs-resolver"
