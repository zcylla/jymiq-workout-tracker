# Copy to .env and fill in from the Supabase dashboard (Project Settings -> API).
# EXPO_PUBLIC_ is bundled into the app, so only ever put the anon/publishable key
# here. The service_role key must never reach the client.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=<anon-publishable-key>
